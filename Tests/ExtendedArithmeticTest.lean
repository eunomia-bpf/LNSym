-- Shift amounts 5..7 are unallocated, with no register/flag/PC updates.
example : ([0x0b221420#32, 0x0b221820#32, 0x0b221c20#32, 0x6b221420#32, 0x6b221820#32, 0x6b221c20#32, 0x8b221420#32, 0x8b221820#32, 0x8b221c20#32, 0xeb221420#32, 0xeb221820#32, 0xeb221c20#32] : List (BitVec 32)).all (fun word =>
    let s := entry word 0x12345678#64 0xffffffff#64
    let t := run 1 s
    (match read_err t with | .Illegal _ => true | _ => false) &&
    read_pc t == read_pc s && read_pstate t == read_pstate s &&
    (List.range 32).all (fun n =>
      let reg := BitVec.ofNat 5 n
      read_gpr 64 reg t == read_gpr 64 reg s &&
      read_sfp 128 reg t == read_sfp 128 reg s)) = true := by native_decide

end ExtendedArithmeticTest
