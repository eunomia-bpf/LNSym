import Arm.Exec

/-! Assembled extended-register ADD/ADDS/SUB/SUBS: every extension in W/X,
all shift amounts 0..4, integer golden results and NZCV, SP/ZR distinctions,
CMP/CMN and destination/source aliases. Inputs/results are independent literals.
-/
section ExtendedArithmeticTest
open BitVec

private def entry (word : BitVec 32) (a b : BitVec 64) : ArmState :=
  let s := write_gpr 64 0#5 0x12345678#64 ArmState.default
  let s := write_gpr 64 1#5 a s
  let s := write_gpr 64 2#5 b s
  let s := write_gpr 64 31#5 0x8877665544332217#64 s
  let s := write_pstate { n := 1#1, z := 0#1, c := 1#1, v := 1#1 } s
  set_program s [(0#64, word)]

private def check (word : BitVec 32) (a b expected : BitVec 64) (nzcv : BitVec 4) : Bool :=
  let s := entry word a b
  let t := run 1 s
  let dst := extractLsb' 0 5 word
  let p := read_pstate t
  read_gpr 64 dst t == expected && p.n ++ p.z ++ p.c ++ p.v == nzcv &&
  read_pc t == 4#64 && read_err t == .None &&
  (List.range 32).all (fun n =>
    let reg := BitVec.ofNat 5 n
    (reg == dst || read_gpr 64 reg t == read_gpr 64 reg s) &&
    read_sfp 128 reg t == read_sfp 128 reg s) &&
  (match mayModifiedRegs word with
    | .ok regs => if getLsbD word 29 && dst == 31#5 then regs == [] else regs == [.GPR dst]
    | _ => false)

