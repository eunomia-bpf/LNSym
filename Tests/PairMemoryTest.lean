import Arm.Exec

/-! Encoded W/X/S/D/Q pairs and LDPSW in signed-offset, pre- and post-index
modes. Literal golden values expose ordering/width/sign/writeback errors;
SP faults must preserve PC, registers, memory and existing access histories.
The tests use flat little-endian memory; permission/fault prefixes and LSE2
access granularity remain separate obligations.
-/
section PairMemoryTest
open BitVec

private def initial : BitVec 256 := 0x112233445566778899aabbccddeeff102132435465768798a9bacbdcedfe0f#256
private def entry (word : BitVec 32) (address : BitVec 64) : ArmState :=
  let s := write_gpr 64 0#5 0xfedcba9876543210#64 ArmState.default
  let s := write_gpr 64 1#5 0x1000#64 s
  let s := write_gpr 64 2#5 0x8899aabbccddeeff#64 s
  let s := write_gpr 64 31#5 0x1000#64 s
  let s := write_sfp 128 0#5 0x0123456789abcdeffedcba9876543210#128 s
  let s := write_sfp 128 1#5 0x2468ace013579bdf1122334455667788#128 s
  let s := write_sfp 128 2#5 0x8899aabbccddeeff0011223344556677#128 s
  let s := write_sfp 128 31#5 0x90000000000000008000000000000001#128 s
  let s := write_pstate { n := 1#1, z := 1#1, c := 1#1, v := 0#1 } s
  let s := write_mem_bytes 32 address initial s
  let s := write_mem_bytes 1 (address - 1#64) 0xa5#8 s
  let s := write_mem_bytes 1 (address + 32#64) 0x5a#8 s
  let s := record_atomic_access
    { operation := .set, address := 8#64, bytes := 1,
      oldValue := 1#64, newValue := 3#64, acquire := false, release := true } s
  let s := write_exclusive_state { monitor := some { physicalStart := 0x9000#64, bytes := 16 } } s
  set_program s [(0#64, word)]

private def check (word : BitVec 32) (address base : BitVec 64)
    (first second : BitVec 128) (memory : BitVec 256) : Bool :=
  let s := entry word address
  let t := run 1 s
  let load := getLsbD word 22
  let simd := getLsbD word 26
  let wb := extractLsb' 23 2 word != 2#2
  let rt := extractLsb' 0 5 word
  let rt2 := extractLsb' 10 5 word
  let rn := extractLsb' 5 5 word
  let expectedRegs :=
    (if load then [if simd then RegType.SFP rt else .GPR rt,
                   if simd then RegType.SFP rt2 else .GPR rt2] else []) ++
    (if wb then [.GPR rn] else [])
  read_pc t == 4#64 && read_err t == .None && read_pstate t == read_pstate s &&
  read_atomic_accesses t == read_atomic_accesses s && read_exclusive_state t == read_exclusive_state s &&
  read_mem_bytes 32 address t == memory &&
  read_mem_bytes 1 (address - 1#64) t == 0xa5#8 && read_mem_bytes 1 (address + 32#64) t == 0x5a#8 &&
  (List.range 32).all (fun n =>
    let r := BitVec.ofNat 5 n
    let gp := if load && !simd && r != 31#5 && r == rt then first.setWidth 64
              else if load && !simd && r != 31#5 && r == rt2 then second.setWidth 64
              else if wb && r == rn then base else read_gpr 64 r s
    let fp := if load && simd && r == rt then first
              else if load && simd && r == rt2 then second else read_sfp 128 r s
    read_gpr 64 r t == gp && read_sfp 128 r t == fp) &&
  (match mayModifiedRegs word with | .ok regs => regs == expectedRegs | _ => false)

