private def refusal (word : BitVec 32) (sp : BitVec 64) (kind : Nat) : Bool :=
  let s := write_gpr 64 31#5 sp (entry word 0x1000#64)
  let t := run 1 s
  (match read_err t with | .Fault _ => kind == 0 | .Illegal _ => kind == 1 | _ => false) &&
  read_pc t == read_pc s && read_pstate t == read_pstate s &&
  read_atomic_accesses t == read_atomic_accesses s && read_exclusive_state t == read_exclusive_state s &&
  read_mem_bytes 128 0xfc0#64 t == read_mem_bytes 128 0xfc0#64 s &&
  (List.range 32).all (fun n =>
    let r := BitVec.ofNat 5 n
    read_gpr 64 r t == read_gpr 64 r s && read_sfp 128 r t == read_sfp 128 r s)

